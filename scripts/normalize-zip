#!/usr/bin/env python3
"""Rewrite a zip with stable, reproducible metadata.

    scripts/normalize-zip PATH

Entries are sorted by name and written with a fixed 1980-01-01 timestamp and
fixed permission bits. Each entry keeps its original compression method (the
declared websockets wheel is stored, the add-on sources are deflated) and its
exact bytes. The archive is replaced atomically, so a failed rewrite leaves the
input untouched.

Python's zlib produces identical output for identical input and compression
level on one machine; a different zlib build can still change deflated bytes.
Reproducibility here means same toolchain, same tree -> same zip, which is what
the release check proves.
"""

from __future__ import annotations

import argparse
import os
import stat
import tempfile
import zipfile
from pathlib import Path

FIXED_DATE = (1980, 1, 1, 0, 0, 0)
FILE_MODE = 0o100644
DIR_MODE = 0o40755
LINK_MODE = 0o120777
COMPRESS_LEVEL = 9


def normalized_info(name: str, source: zipfile.ZipInfo) -> zipfile.ZipInfo:
    info = zipfile.ZipInfo(name, date_time=FIXED_DATE)
    info.compress_type = source.compress_type
    info.create_system = 3
    info.internal_attr = 0
    info.extra = b""
    info.comment = b""

    mode = source.external_attr >> 16
    if stat.S_ISLNK(mode):
        info.external_attr = LINK_MODE << 16
    elif source.is_dir():
        info.external_attr = DIR_MODE << 16
    else:
        info.external_attr = FILE_MODE << 16
    return info


def normalize(path: Path) -> None:
    with zipfile.ZipFile(path) as source:
        entries = [
            (info.filename, source.read(info), normalized_info(info.filename, info))
            for info in source.infolist()
        ]
    entries.sort(key=lambda item: item[0])

    directory = path.resolve().parent
    handle, temporary = tempfile.mkstemp(prefix=".stageloom-zip-", dir=directory)
    os.close(handle)
    try:
        with zipfile.ZipFile(
            temporary, "w", allowZip64=True, compression=zipfile.ZIP_DEFLATED
        ) as target:
            target.comment = b""
            for _name, payload, info in entries:
                target.writestr(info, payload, compresslevel=COMPRESS_LEVEL)
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="scripts/normalize-zip",
        description="Rewrite a zip with sorted entries and fixed timestamps/attributes.",
    )
    parser.add_argument("zip", type=Path, help="zip file to normalize in place")
    args = parser.parse_args()

    if not args.zip.is_file():
        raise SystemExit(f"scripts/normalize-zip: no such zip: {args.zip}")
    try:
        normalize(args.zip)
    except (OSError, zipfile.BadZipFile) as exc:
        raise SystemExit(f"scripts/normalize-zip: cannot rewrite {args.zip}: {exc}") from exc
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
