#!/usr/bin/env bash
# Install the built extension zip into Blender's user repository and enable it.
#
#     scripts/install-extension [path/to/stageloom-x.y.z.zip]
#
# Without an argument, the zip matching the manifest version is used. Build one
# first with scripts/build-extension.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
MANIFEST="$REPO/blender/stageloom/blender_manifest.toml"
VERSION="$(grep -E '^version' "$MANIFEST" | head -1 | cut -d'"' -f2)"

ZIP="${1:-$REPO/dist/stageloom-$VERSION.zip}"
if [ ! -f "$ZIP" ]; then
  echo "no extension zip at $ZIP; run scripts/build-extension first" >&2
  exit 1
fi

LOG="$(mktemp)"
set +e
blender --command extension install-file -r user_default -e "$ZIP" >"$LOG" 2>&1
CODE=$?
set -e
grep -v '^DEBUG' "$LOG" || true
rm -f "$LOG"
if [ "$CODE" -ne 0 ]; then
  echo "install failed: $ZIP" >&2
  exit "$CODE"
fi

echo "installed and enabled: $ZIP"
echo "the add-on appears as 'Stageloom' in Preferences > Add-ons > Extensions"
