#!/usr/bin/env bash
# The stored-baseline gate: three sequential benchmark runs, then a comparison.
#
#     scripts/bench-baseline
#
# The current p50/p95 is the median of the three per-run values. One ambient
# load outlier cannot move the result; a sustained code regression moves all
# three runs. The stored baseline uses the same median-of-three rule. The runs
# are sequential: never run this alongside scripts/check-all or another
# benchmark.
set -euo pipefail

cd "$(dirname "$0")/.."

BASELINE="${STAGELOOM_BASELINE:-benchmarks/results/2026-11-16-linux.json}"
if [ ! -f "$BASELINE" ]; then
  echo "bench-baseline: missing stored baseline: $BASELINE" >&2
  exit 3
fi

TMP="$(mktemp -d "${TMPDIR:-/tmp}/stageloom-bench-baseline.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

REPORTS=()
for index in 1 2 3; do
  echo "bench-baseline: run $index/3"
  log="$TMP/run$index.log"
  if ! scripts/bench --out "$TMP/run$index.json" >"$log" 2>&1; then
    tail -n 40 "$log" || true
    echo "bench-baseline: run $index failed" >&2
    exit 1
  fi
  REPORTS+=(--report "$TMP/run$index.json")
  grep -E '^\[pipeline\] +99458|^\[instances\]|^\[roundtrip\]|^\[multistage\]|^\[playback\]' "$log" || true
done

python3 benchmarks/baseline.py check --baseline "$BASELINE" "${REPORTS[@]}"
