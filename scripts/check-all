#!/usr/bin/env bash
# One local quality gate: docs, lint, core, Blender, benchmarks, extension, C#.
#
#     scripts/check-all          # the full gate
#     scripts/check-all --quick  # inner loop: docs, core, ruff only
#     scripts/check-all --ci     # full gate, with the C# step explicitly skipped
#
# The bench step runs three sequential benchmarks and compares the median
# p50/p95 of each gated metric against the stored baseline. On the reference
# machine a >5% regression fails; on another machine (CI) it prints
# "NOT COMPARABLE" and the summary says the baseline was skipped.
#
# Every step is the existing script (or command) for that layer; this file owns
# the order, the timeout, the per-step timing and the summary, not the test
# logic. A failing step prints its last lines and the summary still lists every
# step. The temporary log directory is removed on exit.
set -uo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)" || exit 1
cd "$REPO" || exit 1

MODE="full"
CI=0
for arg in "$@"; do
  case "$arg" in
    --quick) MODE="quick" ;;
    --ci) CI=1 ;;
    -h|--help)
      cat <<'EOF'
usage: scripts/check-all [--quick|--ci]

  (default)  full gate: docs, lint, core, Blender, bench, extension, C#
  --quick    inner loop: docs, core, ruff
  --ci       full gate with the C# step explicitly skipped (no Rhino on CI)
EOF
      exit 0
      ;;
    *)
      echo "check-all: unknown argument: $arg" >&2
      echo "usage: scripts/check-all [--quick|--ci]" >&2
      exit 2
      ;;
  esac
done

if [ "$MODE" = "quick" ] && [ "$CI" -eq 1 ]; then
  echo "check-all: --quick and --ci are mutually exclusive" >&2
  exit 2
fi

# The per-step caps are backstops, not expected runtimes. test-blender already
# owns its per-suite watchdog; this cap matches that script's own timeout.
CAP_DOCS="${STAGELOOM_DOCS_TIMEOUT:-120}"
CAP_RUFF="${STAGELOOM_RUFF_TIMEOUT:-120}"
CAP_CORE="${STAGELOOM_CORE_TIMEOUT:-120}"
CAP_BLENDER="${STAGELOOM_TEST_BLENDER_TIMEOUT:-900}"
CAP_BENCH="${STAGELOOM_BENCH_TIMEOUT:-600}"
CAP_BASELINE="${STAGELOOM_BASELINE_TIMEOUT:-120}"
CAP_EXTENSION="${STAGELOOM_EXTENSION_TIMEOUT:-300}"
CAP_GHA="${STAGELOOM_GHA_TIMEOUT:-300}"

LOG_DIR="$(mktemp -d "${TMPDIR:-/tmp}/stageloom-check-all.XXXXXX")" || {
  echo "check-all: cannot create a temporary log directory" >&2
  exit 1
}
trap 'rm -rf "$LOG_DIR"' EXIT

HAVE_TIMEOUT=0
if command -v timeout >/dev/null 2>&1; then
  HAVE_TIMEOUT=1
else
  echo "check-all: timeout(1) not found; steps run without a backstop" >&2
fi

# Milliseconds since the epoch, with a whole-seconds fallback where date does
# not support %3N.
now_ms() {
  local value
  value="$(date +%s%3N 2>/dev/null || true)"
  case "$value" in
    ''|*[!0-9]*)
      value="$(date +%s)"
      value=$((value * 1000))
      ;;
  esac
  printf '%s\n' "$value"
}

elapsed_s() {
  awk -v start="$1" -v end="$2" 'BEGIN { printf "%.1f", (end - start) / 1000 }'
}

SUMMARY_NAME=()
SUMMARY_STATUS=()
SUMMARY_SECONDS=()
SUMMARY_NOTE=()
FAILED=0
SKIPPED=0

summary_add() {
  SUMMARY_NAME+=("$1")
  SUMMARY_STATUS+=("$2")
  SUMMARY_SECONDS+=("$3")
  SUMMARY_NOTE+=("${4:-}")
  case "$2" in
    FAIL|TIMEOUT) FAILED=$((FAILED + 1)) ;;
    SKIP) SKIPPED=$((SKIPPED + 1)) ;;
  esac
}

run_step() {
  local name="$1" cap="$2"
  shift 2
  local log="$LOG_DIR/$name.log"
  local start end status seconds mode

  printf '\n== %s ==\n' "$name"
  start="$(now_ms)"
  if [ "$HAVE_TIMEOUT" -eq 1 ]; then
    timeout --signal=TERM --kill-after=15 "$cap" "$@" 2>&1 | tee "$log"
    status="${PIPESTATUS[0]}"
  else
    "$@" 2>&1 | tee "$log"
    status="${PIPESTATUS[0]}"
  fi
  end="$(now_ms)"
  seconds="$(elapsed_s "$start" "$end")"

  if [ "$status" -eq 0 ]; then
    mode="PASS"
    # The benchmark step says whether the stored baseline was actually
    # enforced or skipped because this is another machine. Keep that honesty
    # in the summary instead of printing a bare PASS.
    local note=""
    if grep -q '^\[baseline\] SKIP' "$log" 2>/dev/null; then
      note="baseline skipped (machine differs)"
    elif grep -q '^\[baseline\] PASS' "$log" 2>/dev/null; then
      note="baseline enforced"
    fi
    summary_add "$name" "$mode" "$seconds" "$note"
    printf -- '-- %s: PASS (%ss)%s\n' "$name" "$seconds" "${note:+ — $note}"
    return 0
  fi

  if [ "$status" -eq 124 ] || [ "$status" -eq 137 ]; then
    mode="TIMEOUT"
    summary_add "$name" "$mode" "$seconds" "exceeded ${cap}s"
    printf -- '-- %s: TIMEOUT after %ss (cap %ss)\n' "$name" "$seconds" "$cap"
  else
    mode="FAIL"
    summary_add "$name" "$mode" "$seconds" "exit $status"
    printf -- '-- %s: FAIL after %ss (exit %s)\n' "$name" "$seconds" "$status"
  fi

  # The stream above is the live output; repeat the tail here so the failure is
  # still actionable after the temp log directory is cleaned at exit.
  printf -- '--- %s: last 20 lines ---\n' "$name"
  tail -n 20 "$log" || true
  printf -- '--- end %s ---\n' "$name"
  return "$status"
}

skip_step() {
  local name="$1" note="$2"
  printf '\n== %s ==\n' "$name"
  printf '%s\n' "$note"
  summary_add "$name" "SKIP" "0.0" "$note"
}

# ruff is the one step that is a command rather than a script; build its argv
# so the same timeout/tee/summary path can run it. Prefer an installed ruff,
# then the pinned version through uv, then the interpreter module.
RUFF=()
if command -v ruff >/dev/null 2>&1; then
  RUFF=(ruff)
elif command -v uvx >/dev/null 2>&1; then
  RUFF=(uvx ruff@0.17.2)
elif python3 -m ruff --version >/dev/null 2>&1; then
  RUFF=(python3 -m ruff)
else
  echo "check-all: ruff not found; install ruff 0.17.2 or uv" >&2
  RUFF=(python3 -m ruff)
fi

GATE_START="$(now_ms)"

if [ "$MODE" = "quick" ]; then
  echo "check-all: quick gate (docs, core, ruff); full gate adds Blender, bench, extension, C#"
  run_step "check-docs" "$CAP_DOCS" scripts/check-docs
  run_step "test-core" "$CAP_CORE" scripts/test-core
  run_step "ruff" "$CAP_RUFF" "${RUFF[@]}" check --output-format=concise .
else
  echo "check-all: full gate from $REPO"
  run_step "check-docs" "$CAP_DOCS" scripts/check-docs
  run_step "ruff" "$CAP_RUFF" "${RUFF[@]}" check --output-format=concise .
  run_step "test-core" "$CAP_CORE" scripts/test-core
  # Measure before the long Blender suite: the stored baseline was taken on a
  # quiet machine, and a hot/loaded machine after 85 s of tests moves the p95
  # tail.
  run_step "bench" "$CAP_BENCH" scripts/bench-baseline
  run_step "bench-baseline" "$CAP_BASELINE" scripts/test-bench-baseline
  run_step "test-blender" "$CAP_BLENDER" scripts/test-blender
  run_step "test-extension" "$CAP_EXTENSION" scripts/test-extension
  if [ "$CI" -eq 1 ]; then
    skip_step \
      "test-gha" \
      "csharp: local gate (no Rhino in CI) — skipped scripts/test-gha. It needs wine with Mono's csc, and its conversion/attribute/link/component halves need Rhino 8's managed assemblies; a stock GitHub runner has neither. This gate does not claim C# coverage. The full local gate covers it. A stock-runner codec job is owned by the C# tasks (Q7/Q8)."
  else
    run_step "test-gha" "$CAP_GHA" scripts/test-gha
  fi
fi

GATE_END="$(now_ms)"
GATE_SECONDS="$(elapsed_s "$GATE_START" "$GATE_END")"

printf '\n== summary ==\n'
printf '%-16s %-8s %9s  %s\n' "step" "status" "time" "note"
for i in "${!SUMMARY_NAME[@]}"; do
  printf '%-16s %-8s %8ss  %s\n' \
    "${SUMMARY_NAME[$i]}" "${SUMMARY_STATUS[$i]}" "${SUMMARY_SECONDS[$i]}" "${SUMMARY_NOTE[$i]}"
done
printf '%-16s %-8s %8ss\n' "total" "" "$GATE_SECONDS"

if [ "$FAILED" -ne 0 ]; then
  echo "check-all: FAIL ($FAILED step(s) failed; $MODE gate, ${GATE_SECONDS}s)" >&2
  exit 1
fi
if [ "$SKIPPED" -ne 0 ]; then
  echo "check-all: PASS ($MODE gate, ${GATE_SECONDS}s; $SKIPPED explicit skip)"
else
  echo "check-all: PASS ($MODE gate, ${GATE_SECONDS}s)"
fi
