#!/usr/bin/env bash
# Build the Blender extension zip (S8).
#
#     scripts/build-extension
#
# The zip in dist/ is the install path for users (scripts/install-extension or
# Blender's Install from Disk). scripts/install-addon stays for development: it
# installs the live tree, with no wheel, next to the addons directory.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
SOURCE="$REPO/blender/stageloom"
MANIFEST="$SOURCE/blender_manifest.toml"
OUT="$REPO/dist"
VERSION="$(grep -E '^version' "$MANIFEST" | head -1 | cut -d'"' -f2)"
ZIP="$OUT/stageloom-$VERSION.zip"

# Run Blender with its output filtered for the noisy DEBUG lines, but keep the
# exit status authoritative. The previous pipe through `grep ... || true` let a
# failed validation or build fall through to an older zip.
run_blender() {
  local log code
  log="$(mktemp)"
  set +e
  # --factory-startup keeps the build independent of the user's enabled add-ons
  # and of the stale add-on entries a rebrand leaves behind.
  blender --factory-startup "$@" >"$log" 2>&1
  code=$?
  set -e
  grep -v '^DEBUG' "$log" || true
  rm -f "$log"
  return "$code"
}

# The wheel is third-party code that ships inside the zip; its digest is pinned
# so a modified or substituted wheel fails the build instead of the platform's
# review (which is the only other place it is checked). From PyPI:
# websockets-17.2-py3-none-any.whl.
WHEEL="$SOURCE/wheels/websockets-17.2-py3-none-any.whl"
WHEEL_SHA256="6aa59f0ef92e796b2db6f5f26550c4713c0e4036899fadf02f55e2ed4db0b7ae"
if [ ! -f "$WHEEL" ]; then
  echo "missing wheel: $WHEEL" >&2
  exit 1
fi
if ! echo "$WHEEL_SHA256  $WHEEL" | sha256sum -c --quiet -; then
  echo "wheel digest does not match the pinned sha256 — refusing to build" >&2
  exit 1
fi

# The manifest, its wheel, and the add-on code must validate before building.
run_blender --command extension validate "$SOURCE"

# Stage without the vendored websockets copy or caches: the extension declares
# the official pure-Python wheel instead (manifest `wheels`), so the zip stays
# platform-neutral and does not carry a Linux-only speedups build.
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT
mkdir -p "$STAGE"
tar -C "$SOURCE" \
  --exclude './vendor' \
  --exclude '__pycache__' \
  --exclude '*.pyc' \
  --exclude '*.pyo' \
  -cf - . | tar -C "$STAGE" -xf -

mkdir -p "$OUT"
run_blender --command extension build --source-dir "$STAGE" --output-dir "$OUT"

if [ ! -f "$ZIP" ]; then
  echo "build failed: expected $ZIP" >&2
  exit 1
fi

# A build that silently produced another version must not be uploaded as this
# one. The manifest is the source of truth.
BUILT_VERSION="$(unzip -p "$ZIP" blender_manifest.toml | grep -E '^version' | head -1 | cut -d'"' -f2)"
if [ "$BUILT_VERSION" != "$VERSION" ]; then
  echo "built version $BUILT_VERSION does not match manifest $VERSION" >&2
  exit 1
fi

# Validate the artifact, not just the source: this runs the same checks the
# platform runs, catching "wheel declared but missing", malformed permission
# strings and path-separator mistakes.
run_blender --command extension validate "$ZIP"

# Nothing platform-specific or dev-only may ride inside the zip.
BAD="$(unzip -Z1 "$ZIP" | grep -E '(^|/)vendor/|(^|/)__pycache__/|\.so$|\.exe$|\.pyc$|\.pyo$|\.zip$' || true)"
if [ -n "$BAD" ]; then
  echo "zip carries files that must not ship:" >&2
  echo "$BAD" >&2
  exit 1
fi

echo "built $ZIP ($(stat -c%s "$ZIP") bytes)"
