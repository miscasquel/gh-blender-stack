#!/usr/bin/env bash
# Install the add-on into Blender's user addons directory, live from the working
# tree (development path; the release path is scripts/build-extension).
#
#     scripts/install-addon
#
# The installed package is a generated shim: `bl_info` comes from the manifest
# (single source of truth, G6) and the body of the working tree's `__init__.py`
# runs in it, while `core/` and `blender/` are symlinks to the tree. `websockets`
# is copied next to it because Blender already has the addons directory on
# `sys.path` — no shipped code ever manipulates the module search path (G2).
#
# Then enable "GH Stack" in Blender's Preferences > Add-ons (search for gh_stack).
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
PKG="$REPO/blender/gh_stack"
MANIFEST="$PKG/blender_manifest.toml"
VERSION_RAW="$(grep -E '^version' "$MANIFEST" | head -1 | cut -d'"' -f2)"

BLENDER_VERSION="$(blender --version | head -1 | grep -oE '[0-9]+\.[0-9]+' | head -1)"
ADDONS="${BLENDER_USER_SCRIPTS:-$HOME/.config/blender/$BLENDER_VERSION/scripts}/addons"
mkdir -p "$ADDONS"

DEST="$ADDONS/gh_stack"
rm -rf "$DEST"
mkdir -p "$DEST"
ln -s "$PKG/core" "$DEST/core"
ln -s "$PKG/blender" "$DEST/blender"

# The bl_info the legacy addons list reads; the manifest is authoritative.
python3 - "$MANIFEST" "$PKG/__init__.py" "$DEST/__init__.py" <<'PY'
import sys, tomllib

manifest_path, init_path, dest = sys.argv[1:4]
with open(manifest_path, "rb") as fh:
    manifest = tomllib.load(fh)

def tuple_of(text):
    return tuple(int(part) for part in str(text).split("."))

bl_info = {
    "name": manifest["name"],
    "author": manifest["maintainer"],
    "version": tuple_of(manifest["version"]),
    "blender": tuple_of(manifest.get("blender_version_min", "4.2.0")),
    "location": "View3D > Sidebar > GH Stack",
    "description": manifest.get("tagline", ""),
    "category": "Object",
}

with open(dest, "w") as fh:
    fh.write('"""Generated by scripts/install-addon: bl_info from blender_manifest.toml'
             ' plus the working tree\'s package body. Do not edit."""\n')
    fh.write("bl_info = %r\n\n" % (bl_info,))
    fh.write('# Live tree: core/ and blender/ are symlinks next to this file, so\n'
             '# the body runs in this module\'s namespace with __package__ = "gh_stack".\n')
    fh.write('exec(compile(open(%r).read(), %r, "exec"))\n' % (init_path, init_path))
PY

# websockets for the development install: the addons directory is on sys.path,
# so a top-level package here is found without any path manipulation.
rm -rf "$ADDONS/websockets"
cp -r "$REPO/blender/gh_stack/vendor/websockets" "$ADDONS/websockets"

echo "installed $VERSION_RAW into $DEST (live tree: core/, blender/)"
echo "enable it in Blender: Preferences > Add-ons > search 'GH Stack'"
echo "port and timeout are in the add-on preferences; the panel is in the 3D viewport sidebar (N)"
