#!/usr/bin/env bash
# Layer C, codec half: build the C# core and check it against the golden
# fixtures under wine, then the attribute store (which references RhinoCommon's
# managed ArchivableDictionary; no Rhino process is involved).
set -euo pipefail

cd "$(dirname "$0")/.."
source grasshopper/build/wine-env.sh

grasshopper/build/build.sh

# The deployed .gha is invisible to this suite, but a stale one is a live-session
# hazard. Warn without failing: a mismatch is not a codec regression.
scripts/check-deployed || true

LOG="$(mktemp)"
set +e
run_wine \
  "$(win_path "$PWD/grasshopper/build/out/StageloomCoreTests.exe")" \
  "$(win_path "$PWD/protocol/fixtures")" >"$LOG" 2>&1
CODE=$?
if [ -f grasshopper/build/out/StageloomAttrTests.exe ]; then
  run_wine \
    "$(win_path "$PWD/grasshopper/build/out/StageloomAttrTests.exe")" >>"$LOG" 2>&1
  CODE=$(( CODE | $? ))
fi
# The link half: the real GhLink against a scripted fake server (the socket
# thread, slots, notes, outbox and receive paths; no Rhino document).
if [ -f grasshopper/build/out/StageloomLinkTests.exe ]; then
  run_wine \
    "$(win_path "$PWD/grasshopper/build/out/StageloomLinkTests.exe")" >>"$LOG" 2>&1
  CODE=$(( CODE | $? ))
fi
# Stage In's build guard, without a Grasshopper document or a solve.
if [ -f grasshopper/build/out/StageloomStageTests.exe ]; then
  run_wine \
    "$(win_path "$PWD/grasshopper/build/out/StageloomStageTests.exe")" >>"$LOG" 2>&1
  CODE=$(( CODE | $? ))
fi
set -e

grep -vE 'fixme:|MESA-EGL|pci id|^$' "$LOG" || true
rm -f "$LOG"
exit "$CODE"
