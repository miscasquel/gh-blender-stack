#!/usr/bin/env bash
# Layer C: build the C# suites and run them under wine.
#
#     scripts/test-gha               # full suite: codec, frame fuzz, transport, conversion, attributes, instances, link, components, stage guard
#     scripts/test-gha --codec-only  # codec fixtures + frame fuzz; no Rhino managed assemblies
#
# The full suite requires wine with Mono's csc *and* Rhino 8's managed
# assemblies (RhinoCommon, Grasshopper, GH_IO). A machine with only the codec
# dependencies must use --codec-only; the default fails with the exact missing
# executables instead of silently running a smaller suite.
set -euo pipefail

cd "$(dirname "$0")/.."
source grasshopper/build/wine-env.sh

CODEC_ONLY=0
for arg in "$@"; do
  case "$arg" in
    --codec-only) CODEC_ONLY=1 ;;
    -h|--help)
      cat <<'EOF'
usage: scripts/test-gha [--codec-only]

  (default)     full C# suite; requires Rhino 8's managed assemblies
  --codec-only  run StageloomCoreTests.exe (golden fixtures) and the frame fuzz only
EOF
      exit 0
      ;;
    *)
      echo "test-gha: unknown argument: $arg" >&2
      echo "usage: scripts/test-gha [--codec-only]" >&2
      exit 2
      ;;
  esac
done

OUT_DIR="$PWD/grasshopper/build/out"
CORE="$OUT_DIR/StageloomCoreTests.exe"
FULL=(
  "$CORE"
  "$OUT_DIR/StageloomFuzzTests.exe"
  "$OUT_DIR/StageloomMiniWsTests.exe"
  "$OUT_DIR/StageloomConversionTests.exe"
  "$OUT_DIR/StageloomAttrTests.exe"
  "$OUT_DIR/StageloomInstanceTests.exe"
  "$OUT_DIR/StageloomLinkTests.exe"
  "$OUT_DIR/StageloomComponentTests.exe"
  "$OUT_DIR/StageloomStageTests.exe"
)

# build.sh only builds the Rhino-dependent suites when the managed assemblies
# exist. Remove the outputs first so an old binary from a previous environment
# cannot make the full suite look complete after a Rhino-less build.
if [ "$CODEC_ONLY" -eq 1 ]; then
  rm -f "$CORE" "$OUT_DIR/StageloomFuzzTests.exe"
else
  rm -f "${FULL[@]}"
fi

grasshopper/build/build.sh

if [ "$CODEC_ONLY" -eq 1 ]; then
  if [ ! -f "$CORE" ] || [ ! -f "$OUT_DIR/StageloomFuzzTests.exe" ]; then
    echo "csharp: codec-only: build.sh did not produce the codec/fuzz suites" >&2
    exit 1
  fi
  echo "csharp: codec-only — running StageloomCoreTests.exe and StageloomFuzzTests.exe (no Rhino managed assemblies required)"
else
  MISSING=()
  for exe in "${FULL[@]}"; do
    [ -f "$exe" ] || MISSING+=("$(basename "$exe")")
  done
  if [ "${#MISSING[@]}" -ne 0 ]; then
    echo "C# suite incomplete: grasshopper/build/build.sh did not produce:" >&2
    for name in "${MISSING[@]}"; do
      echo "  - $name" >&2
    done
    echo "The missing suites require Rhino 8's managed assemblies (RhinoCommon, Grasshopper, GH_IO)." >&2
    echo "Set RHINO/WINEPREFIX, or run scripts/test-gha --codec-only to check the codec alone." >&2
    exit 1
  fi
fi

# The deployed .gha is invisible to this suite, but a stale one is a live-session
# hazard. Warn without failing: a mismatch is not a codec regression.
if [ "$CODEC_ONLY" -eq 0 ]; then
  scripts/check-deployed || true
fi

LOG="$(mktemp)"
set +e
if [ "$CODEC_ONLY" -eq 1 ]; then
  run_wine \
    "$(win_path "$CORE")" \
    "$(win_path "$PWD/protocol/fixtures")" >"$LOG" 2>&1
  CODE=$?
  run_wine \
    "$(win_path "$OUT_DIR/StageloomFuzzTests.exe")" >>"$LOG" 2>&1
  CODE=$(( CODE | $? ))
else
  CODE=0
  run_wine \
    "$(win_path "$CORE")" \
    "$(win_path "$PWD/protocol/fixtures")" >"$LOG" 2>&1
  CODE=$(( CODE | $? ))
  # The codec trust boundary under 10,000 deterministic frame mutations plus
  # the Json.Parse contract. No Rhino process or managed assembly is involved.
  run_wine \
    "$(win_path "$OUT_DIR/StageloomFuzzTests.exe")" >>"$LOG" 2>&1
  CODE=$(( CODE | $? ))
  # The transport: handshake verification, frame caps, fragmentation, ping/pong
  # and close handling against an in-process scripted peer. No Rhino process.
  run_wine \
    "$(win_path "$OUT_DIR/StageloomMiniWsTests.exe")" >>"$LOG" 2>&1
  CODE=$(( CODE | $? ))
  # The conversion boundary: section dtypes, lengths, mesh/curve bounds and
  # the wire round trip the encoders share. No Rhino process is involved.
  run_wine \
    "$(win_path "$OUT_DIR/StageloomConversionTests.exe")" >>"$LOG" 2>&1
  CODE=$(( CODE | $? ))
  # The attribute store references RhinoCommon's managed
  # ArchivableDictionary; no Rhino process is involved.
  run_wine \
    "$(win_path "$OUT_DIR/StageloomAttrTests.exe")" >>"$LOG" 2>&1
  CODE=$(( CODE | $? ))
  # The inbound instance grammar: definition table, part namespaces,
  # descriptors, rows and content hash (the native build half is guarded).
  run_wine \
    "$(win_path "$OUT_DIR/StageloomInstanceTests.exe")" \
    "$(win_path "$PWD/protocol/fixtures")" >>"$LOG" 2>&1
  CODE=$(( CODE | $? ))
  # The link half: the real GhLink against a scripted fake server (the socket
  # thread, slots, notes, outbox and receive paths; no Rhino document).
  run_wine \
    "$(win_path "$OUT_DIR/StageloomLinkTests.exe")" >>"$LOG" 2>&1
  CODE=$(( CODE | $? ))
  # The stage components' own status halves: the full plugin source set plus a
  # scripted IGH_DataAccess and WebSocket server.
  run_wine \
    "$(win_path "$OUT_DIR/StageloomComponentTests.exe")" >>"$LOG" 2>&1
  CODE=$(( CODE | $? ))
  # Stage In's build guard, without a Grasshopper document or a solve.
  run_wine \
    "$(win_path "$OUT_DIR/StageloomStageTests.exe")" >>"$LOG" 2>&1
  CODE=$(( CODE | $? ))
fi
set -e

grep -vE 'fixme:|MESA-EGL|pci id|^$' "$LOG" || true
rm -f "$LOG"
exit "$CODE"
