#!/usr/bin/env python3
"""Check the current documentation and config for factual drift.

    scripts/check-docs [--root DIR]

`--root` checks a copy of the tree (used to prove that a mutation fails).
No Blender, no network, and only the Python standard library: the checks are
deterministic and run anywhere.

The contract is intentionally narrow: current claims that have drifted before
(version, the C# hello client string, Python runtime, transport, fixture
inventory, the wheel pin) and the stale paths that must not return to the
current docs. Historical ADR bodies and CHANGELOG release notes are excluded;
they describe the past on purpose.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
from pathlib import Path

# Blender 5.3 ships CPython 3.13. Keep this a constant so the check is the same
# on a machine with Blender, a CI runner, and a checkout without Blender.
EXPECTED_PYTHON = "3.13"

DOC_FILES = (
    "README.md",
    "DEMO.md",
    "docs/plan.md",
    "docs/protocol.md",
    "docs/extensions-compliance.md",
    "docs/plan-quality-0.7-0.8.md",
)

STALE_PATTERNS = (
    (re.compile(r"/home/miquel(?:/|\b)"), "machine-specific /home/miquel path"),
    (re.compile(r"blender/gh_stack\b"), "stale blender/gh_stack path"),
    (re.compile(r"(?:^|[^A-Za-z0-9_])gh_stack/"), "stale gh_stack/ path"),
    (re.compile(r"\]\([^)]*plan-gh2\.md"), "link to the deleted plan-gh2.md"),
    (
        re.compile(r"\]\([^)]*handoff-2026-11-13"),
        "link to the deleted 2026-11-13 handoff",
    ),
    (re.compile(r"\]\([^)]*\bspikes/"), "link to the deleted spikes/ tree"),
    (re.compile(r"\]\([^)]*build-core\.sh"), "link to the deleted build-core.sh"),
    (re.compile(r"blender/stageloom/vendor"), "deleted vendored-tree path"),
)

WHEEL_PATH = "blender/stageloom/wheels/websockets-17.2-py3-none-any.whl"
WHEEL_DECLARATION = "./wheels/websockets-17.2-py3-none-any.whl"


class Checker:
    def __init__(self, root: Path) -> None:
        self.root = root
        self.failures: list[tuple[str, int, str]] = []
        self._cache: dict[str, list[str] | None] = {}

    def fail(self, rel: str, line: int, message: str) -> None:
        self.failures.append((rel, line, message))

    def lines(self, rel: str) -> list[str] | None:
        if rel not in self._cache:
            path = self.root / rel
            try:
                self._cache[rel] = path.read_text(encoding="utf-8").splitlines()
            except OSError as exc:
                self.fail(rel, 1, f"cannot read: {exc}")
                self._cache[rel] = None
        return self._cache[rel]

    def find(self, rel: str, pattern: str, flags: int = 0):
        """Yield (line_number, line, match) for a regex over a file."""
        lines = self.lines(rel)
        if lines is None:
            return
        regex = re.compile(pattern, flags)
        for number, line in enumerate(lines, 1):
            match = regex.search(line)
            if match:
                yield number, line, match


def check_versions(check: Checker) -> None:
    manifest = "blender/stageloom/blender_manifest.toml"
    version = None
    for number, _line, match in check.find(manifest, r'^version\s*=\s*"([^"]+)"'):
        version = match.group(1)
        break
    if version is None:
        check.fail(manifest, 1, "no top-level version = \"...\" in the add-on manifest")
        return

    release = None
    for number, _line, match in check.find(
        "README.md", r"https://github\.com/[^\s)]+/releases/tag/v([^\s)]+)"
    ):
        release = match.group(1)
        release_line = number
        break
    if release is None:
        check.fail("README.md", 1, "no GitHub release link (releases/tag/v<version>)")
    elif release != version:
        check.fail(
            "README.md",
            release_line,
            f"release link is v{release}, manifest is {version}",
        )

    latest = None
    for number, _line, match in check.find("CHANGELOG.md", r"^##\s*\[([^\]]+)\]"):
        latest = match.group(1)
        latest_line = number
        break
    if latest is None:
        check.fail("CHANGELOG.md", 1, "no '## [<version>]' release heading")
    elif latest != version:
        check.fail(
            "CHANGELOG.md",
            latest_line,
            f"latest heading is [{latest}], manifest is {version}",
        )

    check_client_version(check, version)


def check_client_version(check: Checker, version: str) -> None:
    """The C# hello string and the protocol example are checked claims.

    They are the only version literals outside the manifest and the changelog.
    T11 must bump them with the manifest; this check is what makes forgetting
    one a failure instead of a silent drift.
    """
    sources = (
        (
            "grasshopper/src/gh/Publication.cs",
            r'hello\["client"\]\s*=\s*"Stageloom ([^"]+)"',
        ),
        ("docs/protocol.md", r'"client":"Stageloom ([^"]+)"'),
    )
    for rel, pattern in sources:
        found = False
        for number, _line, match in check.find(rel, pattern):
            found = True
            claimed = match.group(1)
            if claimed != version:
                check.fail(
                    rel,
                    number,
                    f"client string is Stageloom {claimed}, manifest is {version}",
                )
        if not found:
            check.fail(rel, 1, "no Stageloom <version> client string found")


def check_python_claim(check: Checker) -> None:
    claim = re.compile(r"Blender\s+5\.3[^\n]*?Python\s+([0-9.]+)")
    found = False
    for number, _line, match in check.find("README.md", claim.pattern):
        found = True
        claimed = match.group(1)
        if claimed != EXPECTED_PYTHON:
            check.fail(
                "README.md",
                number,
                f"README claims Python {claimed}; Blender 5.3 runs Python {EXPECTED_PYTHON}",
            )
    if not found:
        check.fail(
            "README.md",
            1,
            "no 'Blender 5.3 ... Python 3.13' requirements claim found",
        )
    for number, _line, _match in check.find("README.md", r"Python\s+3\.14\b"):
        check.fail(
            "README.md",
            number,
            f"stale Python 3.14 claim; Blender 5.3 runs Python {EXPECTED_PYTHON}",
        )


def check_protocol_transport(check: Checker) -> None:
    rel = "docs/protocol.md"
    lines = check.lines(rel)
    if lines is None:
        return

    start = None
    for number, line in enumerate(lines, 1):
        if re.match(r"^##\s+2\.\s+Transport\s*$", line):
            start = number
            break
    if start is None:
        check.fail(rel, 1, "no '## 2. Transport' section")
        return

    end = len(lines)
    for number in range(start, len(lines)):
        if re.match(r"^##\s+", lines[number]):
            end = number
            break

    section = "\n".join(lines[start - 1 : end])
    if "MiniWsClient" not in section:
        check.fail(rel, start, "transport does not name MiniWsClient")
    if "TcpClient" not in section:
        check.fail(rel, start, "transport does not name TcpClient")
    for number, _line, _match in check.find(rel, r"ClientWebSocket"):
        check.fail(
            rel,
            number,
            "protocol claims ClientWebSocket; the shipped transport is MiniWsClient/TcpClient",
        )


def check_fixture_inventory(check: Checker) -> None:
    """The source owns the fixture names; the directories own the bytes.

    ``protocol/sections.json`` is generated into both codecs, so a fixture
    added or removed without updating it is real drift. The README table is a
    checked mirror, and the directories must match the source exactly.
    """
    rel = "protocol/fixtures/README.md"
    source_rel = "protocol/sections.json"
    source_path = check.root / source_rel
    try:
        source = json.loads(source_path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        check.fail(source_rel, 1, f"cannot read the fixture source: {exc}")
        return
    fixtures = source.get("fixtures") if isinstance(source, dict) else None
    if not isinstance(fixtures, list) or not fixtures:
        check.fail(source_rel, 1, "no non-empty 'fixtures' array")
        return
    names: list[str] = []
    for index, entry in enumerate(fixtures):
        if not isinstance(entry, dict):
            check.fail(source_rel, 1, f"fixtures[{index}] is not an object")
            return
        name = entry.get("name")
        covers = entry.get("covers")
        if not isinstance(name, str) or not name:
            check.fail(source_rel, 1, f"fixtures[{index}].name is not a string")
            return
        if not isinstance(covers, str) or not covers:
            check.fail(source_rel, 1, f"fixture {name} has no coverage note")
        names.append(name)
    duplicates = sorted({name for name in names if names.count(name) > 1})
    if duplicates:
        check.fail(source_rel, 1, "fixture source repeats: " + ", ".join(duplicates))
    if names != sorted(names):
        check.fail(source_rel, 1, "fixture source names must be sorted")

    fixture_root = check.root / "protocol" / "fixtures"
    try:
        directories = sorted(
            path.name for path in fixture_root.iterdir() if path.is_dir()
        )
    except OSError as exc:
        check.fail(source_rel, 1, f"cannot list protocol/fixtures: {exc}")
        return

    source_set = set(names)
    actual = set(directories)
    missing = sorted(actual - source_set)
    extra = sorted(source_set - actual)
    if missing:
        check.fail(
            source_rel,
            1,
            "fixture source is missing directories: "
            + ", ".join(f"`{name}`" for name in missing),
        )
    if extra:
        check.fail(
            source_rel,
            1,
            "fixture source names directories that do not exist: "
            + ", ".join(f"`{name}`" for name in extra),
        )

    rows: list[tuple[int, str, str]] = []
    for number, _line, match in check.find(
        rel, r"^\|\s*`([^`]+)`\s*\|\s*(.*?)\s*\|\s*$"
    ):
        rows.append((number, match.group(1), match.group(2)))

    # Point inventory failures at the table itself, not at line 1.
    anchor = 1
    lines = check.lines(rel) or []
    for number, line in enumerate(lines, 1):
        if line.strip() == "## The fixtures":
            anchor = number
            break

    listed = {name for _number, name, _covers in rows}
    readme_missing = sorted(source_set - listed)
    readme_extra = sorted(listed - source_set)
    readme_duplicates = sorted(
        {name for _number, name, _covers in rows
         if sum(1 for _n, n, _c in rows if n == name) > 1}
    )

    if readme_missing:
        check.fail(
            rel,
            anchor,
            "fixture table is missing: "
            + ", ".join(f"`{name}`" for name in readme_missing),
        )
    if readme_extra:
        check.fail(
            rel,
            anchor,
            "fixture table names entries not in the source: "
            + ", ".join(f"`{name}`" for name in readme_extra),
        )
    if readme_duplicates:
        check.fail(rel, anchor, "fixture table repeats: " + ", ".join(readme_duplicates))
    if len(rows) != len(names):
        check.fail(
            rel,
            anchor,
            f"fixture table lists {len(rows)} entries; the source has {len(names)}",
        )

    covers = {row["name"]: row["covers"] for row in fixtures}
    for number, name, claimed in rows:
        if name in covers and claimed != covers[name]:
            check.fail(
                rel,
                number,
                f"fixture coverage note for `{name}` differs from protocol/sections.json",
            )


def check_wheel_pin(check: Checker) -> None:
    """The official wheel is the only websockets source: it must be declared,
    present, and match the SHA-256 pin the build enforces."""
    manifest = "blender/stageloom/blender_manifest.toml"
    declared = False
    for _number, _line, match in check.find(manifest, r"^wheels\s*=\s*\[(.*)\]\s*$"):
        if WHEEL_DECLARATION in match.group(1):
            declared = True
    if not declared:
        check.fail(
            manifest,
            1,
            f"manifest does not declare the pinned wheel {WHEEL_DECLARATION}",
        )

    wheel = check.root / WHEEL_PATH
    if not wheel.is_file():
        check.fail(WHEEL_PATH, 1, "the declared websockets wheel is missing")
        return

    pin = None
    for number, _line, match in check.find(
        "scripts/build-extension", r'^WHEEL_SHA256="([0-9a-f]{64})"'
    ):
        pin = match.group(1)
        pin_line = number
        break
    if pin is None:
        check.fail("scripts/build-extension", 1, "no WHEEL_SHA256 pin")
    else:
        actual = hashlib.sha256(wheel.read_bytes()).hexdigest()
        if actual != pin:
            check.fail(
                "scripts/build-extension",
                pin_line,
                f"wheel digest is {actual}; the build pins {pin}",
            )

    # The vendored tree and the spike scripts are gone; ruff must not keep a
    # path or an exclusion that claims they are still in the tree.
    for number, line in enumerate(check.lines("ruff.toml") or [], 1):
        if "vendor" in line or "spikes" in line:
            check.fail(
                "ruff.toml",
                number,
                "ruff scope references a deleted tree (vendor or spikes)",
            )


def check_current_docs_paths(check: Checker) -> None:
    for rel in DOC_FILES:
        for number, line, _match in check.find(rel, r".*"):
            for pattern, message in STALE_PATTERNS:
                if pattern.search(line):
                    check.fail(rel, number, message)


def main() -> int:
    parser = argparse.ArgumentParser(prog="scripts/check-docs")
    parser.add_argument(
        "--root",
        default=str(Path(__file__).resolve().parent.parent),
        help="repository root to check (default: this checkout)",
    )
    args = parser.parse_args()
    root = Path(args.root).resolve()

    check = Checker(root)
    check_versions(check)
    check_python_claim(check)
    check_protocol_transport(check)
    check_fixture_inventory(check)
    check_wheel_pin(check)
    check_current_docs_paths(check)

    if check.failures:
        for rel, number, message in check.failures:
            print(f"check-docs: {rel}:{number}: {message}", file=sys.stderr)
        print(f"check-docs: {len(check.failures)} failure(s)", file=sys.stderr)
        return 1

    print(
        "check-docs: ok (version, client string, Python runtime, transport, "
        "fixtures, wheel pin, ruff scope, stale paths)"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
