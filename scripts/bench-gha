#!/usr/bin/env bash
# C# parameter/schema microbenchmark, separate from the test suites.
#
#     scripts/bench-gha [result.json]
#
# Builds StageloomParamBench.exe with the same wine/Mono csc environment as
# grasshopper/build/build.sh, runs it, and stores the JSON under benchmarks/
# results/. The result measures the pure JSON/parameter layer; it does not
# include RhinoCommon/Grasshopper object allocation or the solve.
set -euo pipefail

cd "$(dirname "$0")/.."
source grasshopper/build/wine-env.sh

OUT_DIR="$PWD/grasshopper/build/out"
EXE="$OUT_DIR/StageloomParamBench.exe"
RESULT="${1:-benchmarks/results/$(date +%F)-linux-csharp.json}"

mkdir -p "$OUT_DIR" "$(dirname "$RESULT")"
rm -f "$EXE"

run_csc \
  /nologo /target:exe \
  /out:"$(win_path "$EXE")" \
  /r:System.Numerics.dll \
  "$(win_path "$PWD/grasshopper/src/core/Json.cs")" \
  "$(win_path "$PWD/grasshopper/src/core/Frame.cs")" \
  "$(win_path "$PWD/grasshopper/src/core/ParamValues.cs")" \
  "$(win_path "$PWD/grasshopper/bench/ParamBench.cs")"

[ -f "$EXE" ] || { echo "bench-gha: build failed: $EXE not produced" >&2; exit 1; }

RAW="$(mktemp)"
ERR="$(mktemp)"
trap 'rm -f "$RAW" "$ERR"' EXIT

set +e
WINEPREFIX="$PREFIX" "$WINE" "$(win_path "$EXE")" >"$RAW" 2>"$ERR"
CODE=$?
set -e
if [ "$CODE" -ne 0 ]; then
  cat "$ERR" >&2 || true
  echo "bench-gha: StageloomParamBench.exe exited $CODE" >&2
  exit "$CODE"
fi

python3 - "$RAW" "$RESULT" <<'PY'
import json
import sys

raw, out = sys.argv[1:3]
with open(raw, encoding="utf-8") as handle:
    document = json.load(handle)
document["meta"]["runner"] = "scripts/bench-gha"
document["meta"]["host"] = "wine/Mono (C# 5)"
with open(out, "w", encoding="utf-8") as handle:
    json.dump(document, handle, indent=2)
    handle.write("\n")
print("bench-gha: wrote %s" % out)
for metric in document["metrics"]:
    print("  %-20s %10.3f %-10s (p50)" % (
        metric["name"], metric["p50"], metric["unit"]))
PY
